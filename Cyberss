<script>
/* ================= STATE ================= */
let S = JSON.parse(localStorage.getItem('cr') || '{"score":0,"done":[],"quiz":[],"squad":{}}');
function save(){ localStorage.setItem('cr', JSON.stringify(S)); refresh(); }
function refresh(){
  const pct = Math.round((S.done.length + S.quiz.length) / 16 * 100);
  progBar.style.width = pct+'%';
  progTxt.textContent = 'Progress: ' + pct + '%';
  dashScore.textContent = S.score;
  renderLB();
}

/* ================= NAV ================= */
const views = document.querySelectorAll('.view');
function go(n, btn) {
  views.forEach(v=>v.classList.remove('on'));
  document.querySelectorAll('nav button').forEach(b=>b.classList.remove('on'));
  views[n].classList.add('on'); btn.classList.add('on');
}

/* ================= MODULES + QUIZ ================= */
const MODS = [
 {p:'A',d:1,t:"1. Authentication Factors",c:["KNOW — password, PIN","HAVE — phone, hardware key","ARE — fingerprint, face","MFA = 2+ DIFFERENT types","⚠️ Password + security question = still ONE factor"],
  q:{q:"Password + security question counts as…",o:["Two factors","One factor type (know)","Zero factors"],a:1}},
 {p:'A',d:1,t:"2. 2FA vs MFA",c:["2FA = exactly two factors (subset of MFA)","MFA = any 2+ combination","MFA stops most credential-stuffing","⚠️ Not all MFA equal: passkeys beat typeable codes"],
  q:{q:"The most phishing-resistant MFA is…",o:["SMS codes","TOTP app","Passkey / FIDO2"],a:2}},
 {p:'A',d:2,t:"3. OTP / TOTP Concepts",c:["Shared secret seed + 30-second window = 6-digit code","Codes expire fast → short replay window","⚠️ Can still be phished/relayed in real time","HOTP = counter-based variant"],
  q:{q:"A TOTP code stays valid for about…",o:["30 seconds","10 minutes","24 hours"],a:0}},
 {p:'A',d:2,t:"4. Backup Codes",c:["One-time recovery codes from MFA setup","Store offline/printed — treat like passwords","Each works ONCE","⚠️ Phishers ask for them directly"],
  q:{q:"Backup codes should be stored…",o:["In cloud photos","Offline / printed","In your email drafts"],a:1}},
 {p:'B',d:2,t:"5. Rate Limiting",c:["Lock after N failures (e.g. 5)","Exponential backoff","Alert on push-spam patterns","Without it, 6-digit TOTP = brute-forceable (1M combos)"],
  q:{q:"Rate limiting primarily stops…",o:["Brute-force / MFA guessing","Phishing emails","SIM swaps"],a:0}},
 {p:'B',d:2,t:"6. Recovery Flows",c:["Recovery is where MFA often dies","⚠️ Email-only recovery → email takeover = full takeover","⚠️ Weak help-desk checks → social engineering","Good: MFA-equivalent proof + delay + alerts"],
  q:{q:"The weakest recovery design is…",o:["Hardware key + wait period","Email-link only","In-person verification"],a:1}},
 {p:'B',d:3,t:"7. Session Security",c:["MFA protects LOGIN; sessions protect everything after","⚠️ Stolen cookie = MFA never re-asked","Defenses: short lifetimes, device binding, revoke on change","Cookies: Secure, HttpOnly, SameSite"],
  q:{q:"A stolen session cookie bypasses…",o:["The password only","The MFA re-prompt","Nothing"],a:1}},
 {p:'C',d:3,t:"8. Common Implementation Weaknesses",c:["SMS → SIM swap / SS7","TOTP → real-time phishing relay","Push → fatigue bombing","MFA not enforced on API endpoints (the Request C bug!)","Backup codes in plaintext"],
  q:{q:"The 'Request C' bug is…",o:["MFA missing on an API endpoint","A weak password","An expired cookie"],a:0}},
];

function renderMods(){
  ['A','B','C'].forEach(p=>document.getElementById('path'+p).innerHTML='');
  MODS.forEach((m,i)=>{
    const stars = '<span class="diff d'+m.d+'">'+'★'.repeat(m.d)+'</span>';
    const quizDone = S.quiz.includes(i);
    const d = document.createElement('details');
    d.innerHTML = `<summary>${m.t} ${stars} ${S.done.includes(i)?'✅':''} ${quizDone?'🧠':''}</summary>
      <div class="mod-body"><ul>${m.c.map(l=>`<li>${l}</li>`).join('')}</ul>
      <button class="btn btn-green" onclick="mod(${i})">✔ Complete (+10)</button>
      <p style="margin:10px 0 4px;color:#d29922"><b>🧠 Knowledge Check (+5)</b></p>
      <p style="color:#c9d1d9">${m.q.q}</p>
      ${m.q.o.map((o,j)=>`<button class="quiz-opt" onclick="quiz(${i},${j},this)">${o}</button>`).join('')}
      </div>`;
    document.getElementById('path'+m.p).appendChild(d);
  });
}
function mod(i){ if(!S.done.includes(i)){ S.done.push(i); S.score+=10; } save(); renderMods(); }
function quiz(i,j,btn){
  if(S.quiz.includes(i)) return;
  if(j===MODS[i].q.a){ S.quiz.push(i); S.score+=5; btn.style.borderColor='#3fb950'; btn.style.color='#3fb950'; }
  else { btn.style.borderColor='#f85149'; btn.style.color='#f85149'; }
  save(); renderMods();
}

/* ================= LAB ================= */
let busy=false, passed=false;
function L(html,ms){ return new Promise(r=>setTimeout(()=>{ labLog.innerHTML+=html+'\n'; labLog.scrollTop=1e6; r(); },ms||350)); }
async function runAttack(){
  if(busy) return; busy=true; verdict.style.display='none';
  const mfa = swMFA.classList.contains('on'), rate = swRate.classList.contains('on'),
        bind = swBind.classList.contains('on'), type = mfaType.value;
  labLog.innerHTML='';
  await L('<span class="info">[ATTACKER] Replaying captured Request C → POST /api/account/settings</span>',300);
  await L('  Cookie: session=STOLEN_COOKIE_9f2',250);
  await L('  (no fresh MFA assertion — just a replay)',250);
  await L('<span class="info">[SERVER] ── evaluating ──</span>',400);
  let blocked=false;
  if(!mfa){
    await L('<span class="bad">→ MFA_ENFORCED = false … skipping MFA check ⚠️</span>',400);
  } else {
    await L('→ MFA assertion check… <span class="warn">MISSING</span>',400);
    if(type==='passkey'){ await L('→ Passkey required: origin-bound challenge. Replay impossible. <span class="bad">⛔ 403</span>',450); blocked=true; }
    else { await L(`→ ${type.toUpperCase()} code in replay is outside validity window… <span class="bad">⛔ 403 EXPIRED</span>`,450); blocked=true; }
    if(type==='sms') await L('<span class="warn">  note: SMS would still be SIM-swappable — upgrade to app/passkey</span>',300);
    if(type==='push') await L('<span class="warn">  note: enable number matching to stop push fatigue</span>',300);
  }
  if(!blocked && bind){
    await L('→ Device fingerprint mismatch vs. bound session… <span class="bad">⛔ 403 DEVICE MISMATCH</span>',450);
    blocked=true;
  }
  if(!blocked && !rate){
    await L('<span class="bad">→ No rate limiter — attacker brute-forces 6-digit code…</span>',400);
    await L('<span class="bad">  attempt 412,307 … CODE MATCHED 😱</span>',500);
  } else if(!blocked && rate){
    await L('→ Attempt 6 from 203.0.113.7 — <span class="bad">⛔ 429 RATE LIMITED, account locked</span>',450);
    blocked=true;
  }
  await L('<span class="info">[SERVER] ── verdict ──</span>',400);
  verdict.style.display='block';
  if(blocked){
    verdict.className='verdict pass';
    verdict.innerHTML='✅ VERIFICATION: PASS — Unauthorized access DENIED<br><span style="font-size:13px">+20 pts. The defense held. 🛡️</span>';
    if(!passed){ passed=true; S.score+=20; save(); }
    await L('<span style="color:#3fb950">⛔ ACCESS DENIED. Session revoked. Admin alerted. 🔔</span>',300);
  } else {
    verdict.className='verdict fail';
    verdict.innerHTML='❌ VERIFICATION: FAIL — Attacker got in (200 OK)<br><span style="font-size:13px">Fix the toggles above and hit RE-TEST. 🔁</span>';
    await L('<span class="bad">⚠️ HTTP 200 — attacker modified account settings.</span>',300);
  }
  retestBtn.style.display='block'; busy=false;
}

/* ================= SQUAD ================= */
function joinSquad(){
  const n = callsign.value.trim(); if(!n) return;
  S.squad[n] = Math.max(S.squad[n]||0, S.score);
  greet.textContent = 'Welcome, ' + n;
  save();
}
function renderLB(){
  const rows = Object.entries(S.squad).sort((a,b)=>b[1]-a[1]);
  lb.innerHTML = rows.length
    ? rows.map((r,i)=>`<div class="lb-row"><span>${['🥇','🥈','🥉'][i]||'▫️'} ${r[0]}</span><b style="color:#d29922">${r[1]}</b></div>`).join('')
    : '<p style="padding:8px">No operators yet — be the first.</p>';
}
function shareScore(){
  const txt = `🛡️ CyberRange result: ${S.score} pts · ${S.done.length}/8 modules · ${S.quiz.length}/8 checks · Lab ${passed?'PASS ✅':'not passed yet'}`;
  navigator.clipboard && navigator.clipboard.writeText(txt);
  alert('Copied! Paste it in your class chat. 📋');
}

renderMods(); refresh();
</script>
</body>
</html>
